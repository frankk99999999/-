# Copy to .env and adjust if needed.

# --- Postgres (OLTP: accounts, campaigns, agent actions) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=converge
PG_PASSWORD=converge
PG_DB=converge

# --- ClickHouse (OLAP: the event firehose) ---
CH_HOST=localhost
CH_PORT=8123
CH_USER=converge
CH_PASSWORD=converge
CH_DB=converge

# --- Simulation knobs ---
SIM_DAYS=7              # how many days of history to generate
SIM_ACCOUNTS=5          # number of ad accounts
SIM_CAMPAIGNS_PER_ACCOUNT=8
SIM_IMPRESSIONS_PER_DAY=20000   # per campaign; keep modest for a laptop
SIM_SEED=42

# --- Agent knobs ---
AGENT_TARGET_ROAS=2.0   # below this, cut budget
AGENT_SCALE_ROAS=4.0    # above this, raise budget
AGENT_MAX_BUDGET_CHANGE_PCT=0.30  # never change budget by more than 30% in one step
